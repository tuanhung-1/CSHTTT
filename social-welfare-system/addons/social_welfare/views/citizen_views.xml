<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_social_citizen_list" model="ir.ui.view">
        <field name="name">social.citizen.list</field>
        <field name="model">social.citizen</field>
        <field name="arch" type="xml">
            <list string="Citizens">
                <field name="citizen_code"/>
                <field name="full_name"/>
                <field name="date_of_birth"/>
                <field name="gender"/>
                <field name="relationship"/>
                <field name="household_id"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <record id="view_social_citizen_form" model="ir.ui.view">
        <field name="name">social.citizen.form</field>
        <field name="model">social.citizen</field>
        <field name="arch" type="xml">
            <form string="Citizen">
                <sheet>
                    <group>
                        <field name="citizen_code"/>
                        <field name="full_name"/>
                        <field name="date_of_birth"/>
                        <field name="gender"/>
                        <field name="relationship"/>
                        <field name="household_id"/>
                        <field name="phone"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_social_citizen" model="ir.actions.act_window">
        <field name="name">Citizens</field>
        <field name="res_model">social.citizen</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_social_citizen"
        name="Citizens"
        parent="menu_social_welfare_root"
        action="action_social_citizen"
        sequence="20"
    />

</odoo>