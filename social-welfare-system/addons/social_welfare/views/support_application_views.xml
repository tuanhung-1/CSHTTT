<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="view_social_support_application_list" model="ir.ui.view">
        <field name="name">social.support.application.list</field>
        <field name="model">social.support.application</field>
        <field name="arch" type="xml">
            <list string="Support Applications">
                <field name="application_code"/>
                <field name="household_id"/>
                <field name="program_id"/>
                <field name="application_date"/>
                <field name="requested_amount"/>
                <field name="approved_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_social_support_application_search" model="ir.ui.view">
        <field name="name">social.support.application.search</field>
        <field name="model">social.support.application</field>
        <field name="arch" type="xml">
            <search string="Support Applications">
                <field name="application_code"/>
                <field name="household_id"/>
                <field name="program_id"/>
                <field name="state"/>
                <separator/>
                <filter name="state_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="state_submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="state_reviewing" string="Reviewing" domain="[('state', '=', 'reviewing')]"/>
                <filter name="state_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="state_rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="state_paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_program" string="Support Program" context="{'group_by': 'program_id'}"/>
                    <filter name="group_household" string="Household" context="{'group_by': 'household_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_social_support_application_form" model="ir.ui.view">
        <field name="name">social.support.application.form</field>
        <field name="model">social.support.application</field>
        <field name="arch" type="xml">

            <form string="Support Application">

                <header>

                    <button
                        name="action_submit"
                        groups="social_welfare.group_social_welfare_officer"
                        string="Submit"
                        type="object"
                        invisible="state != 'draft'"
                    />

                    <button
                        name="action_review"
                        groups="social_welfare.group_social_welfare_reviewer"
                        string="Start Review"
                        type="object"
                        invisible="state != 'submitted'"
                    />

                    <button
                        name="action_approve"
                        groups="social_welfare.group_social_welfare_reviewer"
                        string="Approve"
                        type="object"
                        invisible="state != 'reviewing'"
                    />

                    <button
                        name="action_reject"
                        groups="social_welfare.group_social_welfare_reviewer"
                        string="Reject"
                        type="object"
                        invisible="state != 'reviewing'"
                    />

                    <button
                        name="action_paid"
                        groups="social_welfare.group_social_welfare_reviewer"
                        string="Mark as Paid"
                        type="object"
                        invisible="state != 'approved'"
                    />

                    <button
                        name="action_reset_draft"
                        groups="social_welfare.group_social_welfare_reviewer"
                        string="Reset to Draft"
                        type="object"
                        invisible="state != 'rejected'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        readonly="1"
                        statusbar_visible="draft,submitted,reviewing,approved,rejected,paid"
                    />

                </header>

                <sheet>

                    <group>

                        <group>
                            <field name="application_code" readonly="state != 'draft'"/>
                            <field name="household_id" readonly="state != 'draft'"/>
                            <field name="program_id" readonly="state != 'draft'"/>
                            <field name="application_date" readonly="state != 'draft'"/>
                        </group>

                        <group>
                            <field name="requested_amount" readonly="state != 'draft'"/>
                            <field name="approved_amount" readonly="state != 'reviewing'"/>
                        </group>

                    </group>

                    <group>
                        <field name="reason" readonly="state != 'draft'"/>
                        <field name="review_note" readonly="state != 'reviewing'"/>
                    </group>

                </sheet>

            </form>

        </field>
    </record>

    <!-- Action -->
    <record id="action_social_support_application" model="ir.actions.act_window">
        <field name="name">Support Applications</field>
        <field name="res_model">social.support.application</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_social_support_application_search"/>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_social_support_application"
        name="Support Applications"
        parent="menu_social_welfare_root"
        action="action_social_support_application"
        groups="social_welfare.group_social_welfare_officer"
        sequence="40"
    />

</odoo>
