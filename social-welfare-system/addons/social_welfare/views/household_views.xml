<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="view_social_household_list" model="ir.ui.view">
        <field name="name">social.household.list</field>
        <field name="model">social.household</field>
        <field name="arch" type="xml">
            <list string="Households">
                <field name="household_code"/>
                <field name="head_citizen_id"/>
                <field name="head_name"/>
                <field name="address"/>
                <field name="member_count"/>
                <field name="average_income"/>
                <field name="poverty_status"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_social_household_form" model="ir.ui.view">
        <field name="name">social.household.form</field>
        <field name="model">social.household</field>
        <field name="arch" type="xml">
            <form string="Household">
                <sheet>
                    <group>
                        <field name="household_code"/>
                        <field name="head_citizen_id" domain="[('household_id', '=', id)]"/>
                        <field name="head_name"/>
                        <field name="address"/>
                        <field name="member_count" readonly="1"/>
                        <field name="average_income"/>
                        <field name="poverty_status"/>
                    </group>
                    <notebook>

    <page string="Household Members">

        <field name="citizen_ids">

            <list editable="bottom">

                <field name="citizen_code"/>
                <field name="full_name"/>
                <field name="date_of_birth"/>
                <field name="gender"/>
                <field name="relationship"/>
                <field name="phone"/>

            </list>

        </field>

    </page>

</notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_social_household" model="ir.actions.act_window">
        <field name="name">Households</field>
        <field name="res_model">social.household</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Main Menu -->
    <menuitem
        id="menu_social_welfare_root"
        name="Social Welfare"
        sequence="10"
    />

    <!-- Household Menu -->
    <menuitem
        id="menu_social_household"
        name="Households"
        parent="menu_social_welfare_root"
        action="action_social_household"
        sequence="10"
    />

</odoo>
